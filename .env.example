# Local Postgres (see docs/infrastructure.md, Environments)
TRADING_DATABASE_URL=postgresql:///trading

# Alpaca paper accounts: one key pair per mirrored portfolio label
ALPACA_PAPER_1_KEY_ID=
ALPACA_PAPER_1_SECRET_KEY=
ALPACA_PAPER_2_KEY_ID=
ALPACA_PAPER_2_SECRET_KEY=
ALPACA_PAPER_3_KEY_ID=
ALPACA_PAPER_3_SECRET_KEY=

# Data providers (adapters read these once built)
FMP_API_KEY=
FRED_API_KEY=

# Claude runs on the Max subscription: token from `claude setup-token`.
# Never set ANTHROPIC_API_KEY here; it would override the subscription.
CLAUDE_CODE_OAUTH_TOKEN=
